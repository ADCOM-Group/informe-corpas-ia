].map(kpi).join('');
const dmax = Math.max(...D.calls_por_dia.map(x => x[1]));
const DOW = ['dom','lun','mar','mié','jue','vie','sáb'];
$('dias').innerHTML = D.calls_por_dia.map(([d, n]) => `<div class="col" title="${fecha(d)}: ${n} llamadas"><b>${n}</b><div style="height:${Math.max(2, 150 * n / dmax)}px"></div></div>`).join('');
$('dias-l').innerHTML = D.calls_por_dia.map(([d]) => { const x = new Date(d + 'T12:00:00'); return `<span>${DOW[x.getDay()]} ${x.getDate()}</span>`; }).join('');

// Resultados
const rc = cnt(conv, r => r.res);
const interes = (rc['Sí, quiero iniciar'] || 0) + (rc['Tal vez'] || 0);
$('h-resultados').textContent = `${interes} de las ${conv.length} personas que conversaron mostraron interés.`;
bars($('res-bars'), RES_ORD.filter(k => rc[k]).map(k => ({lab: k, n: rc[k], tot: conv.length, c: (k === 'Sí, quiero iniciar' || k === 'Tal vez') ? '' : 'g-otro'})));

// Intentos
const dist = cnt(R, r => Math.min(r.n, 6));
const conAt = R.filter(r => r.ic), icn = cnt(conAt, r => Math.min(r.ic, 6));
const lab = n => n >= 6 ? '6 o más' : n === 1 ? '1 llamada' : n + ' llamadas';
const prom = R.reduce((s, r) => s + r.n, 0) / R.length;
$('h-intentos').textContent = `En promedio ${prom.toLocaleString('es-CO', {maximumFractionDigits: 1})} llamadas por persona; ${pct(icn[1] || 0, conAt.length)} de las conversaciones salen en el primer intento.`;
bars($('int-dist'), [1, 2, 3, 4, 5, 6].filter(k => dist[k]).map(k => ({lab: lab(k), n: dist[k], tot: R.length})));
$('int-conv-n').textContent = `${conAt.length} personas que conversaron`;
bars($('int-conv'), [1, 2, 3, 4, 5, 6].map(k => ({lab: k >= 6 ? 'Intento 6 o más' : 'Intento ' + k, n: icn[k] || 0, tot: conAt.length})));
const STOP = [['gestionado', 'El asesor ya las gestionó en HubSpot'], ['contesto', 'Contestaron, pero sin conversación'],
  ['agoto', 'Completaron los intentos sin contestar'], ['pendiente', 'Todavía tienen intentos programados']];
const noConv = R.filter(r => !r.ic), sc2 = cnt(noConv, r => r.stop);
$('int-stop-n').textContent = `${noConv.length} personas; el agente dejó de llamar a las que ya gestionó un asesor`;
bars($('int-stop'), STOP.filter(([k]) => sc2[k]).map(([k, l]) => ({lab: l, n: sc2[k], tot: noConv.length, c: k === 'gestionado' ? '' : 'g-otro'})));

// Perfilamiento
const PF = R.filter(r => r.pf);
$('h-perfil').textContent = `El agente marca como perfilado solo a quien dice “Sí, quiero iniciar” para 2027-1: ${PF.length} contactos desde el 10 de noviembre.`;
$('perf-tabla').innerHTML = `<thead><tr><th>Resultado con el agente</th><th class="r">Personas</th><th>¿Queda perfilado?</th></tr></thead><tbody>` +
  RES_ORD.filter(k => R.some(r => r.res === k)).map(k => { const gg = R.filter(r => r.res === k), np = gg.filter(r => r.pf).length;
    return `<tr><td class="who">${esc(k)}</td><td class="r">${gg.length}</td><td>${k === 'Sí, quiero iniciar' ? `<span class="tag tag-si">Sí</span> <span class="t-mute">· ${np} marcados</span>` : '<span class="tag tag-no">No</span>'}</td></tr>`; }).join('') + '</tbody>';
const tkP = cnt(PF.filter(r => r.tarea), r => r.tarea);
$('perf-tareas').textContent = `de los ${PF.length} perfilados, ${(tkP['Completada'] || 0) + (tkP['Pendiente'] || 0)} tienen la tarea (${tkP['Completada'] || 0} completadas y ${tkP['Pendiente'] || 0} pendientes).`;

// Estado en HubSpot
const hc = cnt(HS, r => r.hoy);
const desp = HS.filter(r => (r.quien || '').startsWith('Asesor')).length;
$('h-estado').textContent = `${desp} de los ${HS.length} contactos ya tienen un cambio de estado hecho por un asesor después de la llamada.`;
bars($('estado-bars'), Object.entries(hc).sort((a, b) => b[1] - a[1]).map(([k, n]) => ({lab: k, n, tot: HS.length, c: 'g-' + g(k)})));
const ga = cnt(HS, r => g(r.antes)), gh = cnt(HS, r => g(r.hoy));
$('antes-hoy').innerHTML = [['Antes', ga], ['Hoy', gh]].map(([l, m]) =>
  `<div class="stk"><span class="lab">${l}</span><div class="seg" role="img" aria-label="${l}: ${GORD.map(k => GL[k] + ' ' + (m[k] || 0)).join(', ')}">${GORD.filter(k => m[k]).map(k =>
    `<div class="g-${k}" style="flex:${m[k]}" title="${GL[k]}: ${m[k]}">${m[k] / HS.length > 0.06 ? m[k] : ''}</div>`).join('')}</div></div>`).join('');
$('leg-grupos').innerHTML = GORD.map(k => `<span><i class="g-${k}"></i>${GL[k]}: antes ${ga[k] || 0}, hoy ${gh[k] || 0}</span>`).join('');
const tr = Object.entries(cnt(HS.filter(r => r.antes !== r.hoy), r => r.antes + '→' + r.hoy)).sort((a, b) => b[1] - a[1]).slice(0, 6);
bars($('trans'), tr.map(([k, n]) => { const [a, b] = k.split('→'); return {lab: a + ' → ' + b, html: `${esc(a)} → ${esc(b)}`, n, c: 'g-' + g(b)}; }));
const mt = RES_ORD.filter(k => HS.some(r => r.res === k));
$('matriz').innerHTML = `<thead><tr><th>Resultado con el agente</th><th class="r">Contactos</th>${GORD.map(k => `<th class="r">${GL[k]}</th>`).join('')}</tr></thead><tbody>` +
  mt.map(k => { const gg = HS.filter(r => r.res === k), m = cnt(gg, r => g(r.hoy));
    return `<tr><td class="who">${esc(k)}</td><td class="r">${gg.length}</td>${GORD.map(x => `<td class="r">${m[x] || 0}</td>`).join('')}</tr>`; }).join('') + '</tbody>';

// Gestión de asesores
const conA = HS.filter(r => r.acall > 0), conC = HS.filter(r => r.acon > 0);
const tk = cnt(R.filter(r => r.tarea && r.pf), r => r.tarea), tkT = (tk['Completada'] || 0) + (tk['Pendiente'] || 0);
$('h-gestion').textContent = `Los asesores llamaron a ${pct(conA.length, HS.length)} de los contactos después del agente, en una mediana de ${horas(median(conA.map(r => r.horas)))}.`;
$('kpis-g').innerHTML = [
  [fmt(conA.length), 'Con llamada de asesor', `de ${HS.length} contactos`, true], [fmt(conC.length), 'Contestaron al asesor', pct(conC.length, conA.length) + ' de los llamados'],
  [horas(median(conA.map(r => r.horas))), 'Hasta la primera llamada del asesor', 'mediana'],
  [`${tk['Completada'] || 0} de ${tkT}`, 'Tareas “Seguimiento Perfilamiento IA”', 'completadas, de los perfilados que tienen tarea']
].map(kpi).join('');
$('g-tabla').innerHTML = `<thead><tr><th>Resultado con el agente</th><th class="r">Contactos</th><th class="r">Asesor llamó</th><th class="r">Contestaron al asesor</th><th class="r">Hasta el asesor (mediana)</th><th class="r">Cambio de estado por asesor</th></tr></thead><tbody>` +
  mt.map(k => { const gg = HS.filter(r => r.res === k), a = gg.filter(r => r.acall > 0);
    return `<tr><td class="who">${esc(k)}</td><td class="r">${gg.length}</td><td class="r">${a.length} <span class="t-mute">· ${pct(a.length, gg.length)}</span></td><td class="r">${gg.filter(r => r.acon > 0).length}</td><td class="r">${horas(median(a.map(r => r.horas)))}</td><td class="r">${gg.filter(r => (r.quien || '').startsWith('Asesor')).length}</td></tr>`; }).join('') + '</tbody>';

// Los que dijeron Sí
const SI = R.filter(r => r.res === 'Sí, quiero iniciar').sort((a, b) => GORD.indexOf(g(a.hoy)) - GORD.indexOf(g(b.hoy)) || a.f1.localeCompare(b.f1));
const siA = SI.filter(r => r.acall > 0), siG = cnt(SI.filter(r => r.hs), r => g(r.hoy));
$('n-si-side').textContent = SI.length; $('n-all-side').textContent = R.length;
$('h-si').textContent = `${SI.length} personas dijeron “Sí, quiero iniciar”: ${siG.avanzo || 0} ya avanzaron, ${siG.seguimiento || 0} están en seguimiento, ${siG.interesado || 0} siguen en Interesado o sin estado, ${siG.nocontesta || 0} no le contestaron al asesor y ${siG.desiste || 0} están en Desiste.`;
$('si-note').innerHTML = `<b>${siA.length} de ${SI.length}</b> tienen una llamada de asesor registrada después del agente (mediana ${horas(median(siA.map(r => r.horas)))}). <b>${SI.length - siA.length}</b> no tienen ninguna llamada de asesor en HubSpot; pueden haber sido contactados por WhatsApp o correo.`;
const asesorCell = r => r.hs ? (r.acall ? `${r.acall} <span class="t-mute">· ${r.acon} contestó</span>` : '<span class="t-neg">Ninguna</span>') : '–';
const estadoCell = r => r.hs ? `<span class="from">${esc(r.antes)} →</span>${pill(r.hoy)}` : '<span class="t-mute">No está en HubSpot</span>';
const who = r => `<td class="who">${esc(r.nom || 'Sin nombre')}${r.hs ? `<small>ID ${esc(r.k)}</small>` : ''}</td>`;
$('si-tabla').innerHTML = `<thead><tr><th>Contacto</th><th>Programa</th><th class="r">Llamada del agente</th><th>Estado antes → hoy</th><th>Perfilado IA · tarea</th><th class="r">Llamadas del asesor después del agente</th><th class="r">Hasta el asesor</th><th>Último cambio de estado</th></tr></thead><tbody>` +
  SI.map(r => `<tr>${who(r)}<td>${esc(r.prog)}</td><td class="r">${fecha(r.f1)}</td><td>${estadoCell(r)}</td><td>${r.pf ? '<span class="tag tag-si">Sí</span>' : '<span class="tag tag-no">No</span>'} <span class="t-mute">· ${r.tarea ? 'tarea ' + r.tarea.toLowerCase() : 'sin tarea'}</span></td><td class="r">${asesorCell(r)}</td><td class="r">${r.hs && r.acall ? horas(r.horas) : '–'}</td><td>${esc(r.quien ? r.quien + ' · ' + fecha(r.cambio) : '')}</td></tr>`).join('') + '</tbody>';

// Todos los contactos
const opts = (id, vals) => $(id).innerHTML = `<option value="">Todos</option>` + vals.map(v => `<option>${esc(v)}</option>`).join('');
opts('f-res', RES_ORD.filter(k => R.some(r => r.res === k)));
opts('f-hoy', Object.keys(GRP).filter(k => HS.some(r => r.hoy === k)));
opts('f-prog', [...new Set(R.map(r => r.prog))].sort());
let sortK = 'res', sortD = 1;
const COLS = [['nom', 'Contacto'], ['prog', 'Programa'], ['f1', 'Llamada del agente', 'r'], ['n', 'Llamadas del agente', 'r'], ['res', 'Resultado con el agente'],
  ['hoy', 'Estado antes → hoy'], ['acall', 'Llamadas del asesor', 'r'], ['horas', 'Hasta el asesor', 'r'], ['cambio', 'Último cambio de estado']];
function renderC() {
  const fr = $('f-res').value, fh = $('f-hoy').value, fp = $('f-prog').value, q = $('f-q').value.trim().toLowerCase();
  const L = R.filter(r => (!fr || r.res === fr) && (!fh || r.hoy === fh) && (!fp || r.prog === fp) && (!q || (r.nom || '').toLowerCase().includes(q) || String(r.k).includes(q)));
  const key = r => sortK === 'res' ? RES_ORD.indexOf(r.res) : sortK === 'hoy' ? GORD.indexOf(g(r.hoy)) * 100 + Object.keys(GRP).indexOf(r.hoy) : (r[sortK] ?? '');
  L.sort((a, b) => { const x = key(a), y = key(b); return (x > y ? 1 : x < y ? -1 : a.f1.localeCompare(b.f1)) * sortD; });
  $('f-count').textContent = `${L.length} de ${R.length} personas`;
  $('c-tabla').innerHTML = `<thead><tr>${COLS.map(([k, l, c]) => `<th class="s ${c || ''} ${sortK === k ? 'on' : ''}" data-k="${k}" tabindex="0" aria-sort="${sortK === k ? (sortD > 0 ? 'ascending' : 'descending') : 'none'}">${l}${sortK === k ? (sortD > 0 ? ' ↑' : ' ↓') : ''}</th>`).join('')}</tr></thead><tbody>` +
    L.map(r => `<tr>${who(r)}<td>${esc(r.prog)}</td><td class="r">${fecha(r.f1)}</td><td class="r">${r.n}</td><td>${esc(r.res)}</td><td>${estadoCell(r)}</td>
      <td class="r">${r.hs ? (r.acall ? `${r.acall} <span class="t-mute">· ${r.acon} contestó</span>` : '<span class="t-mute">Ninguna</span>') : '–'}</td>
      <td class="r">${r.hs && r.acall ? horas(r.horas) : '–'}</td><td>${esc(r.quien ? r.quien + ' · ' + fecha(r.cambio) : '')}</td></tr>`).join('') + '</tbody>';
}
['f-res', 'f-hoy', 'f-prog', 'f-q'].forEach(id => $(id).addEventListener('input', renderC));
$('f-reset').addEventListener('click', () => { ['f-res', 'f-hoy', 'f-prog', 'f-q'].forEach(id => $(id).value = ''); sortK = 'res'; sortD = 1; renderC(); });
$('c-tabla').addEventListener('click', e => { const th = e.target.closest('th[data-k]'); if (!th) return; sortD = sortK === th.dataset.k ? -sortD : 1; sortK = th.dataset.k; renderC(); });
$('c-tabla').addEventListener('keydown', e => { if (e.key === 'Enter') { const th = e.target.closest('th[data-k]'); if (th) th.click(); } });
renderC();

// Por programa
const PG = [...new Set(R.map(r => r.prog))].map(p => { const gg = R.filter(r => r.prog === p), h = gg.filter(r => r.hs);
  return {p, n: gg.reduce((s, r) => s + r.n, 0), per: gg.length, cv: gg.filter(r => r.conv).length, si: gg.filter(r => r.res === 'Sí, quiero iniciar').length,
    tv: gg.filter(r => r.res === 'Tal vez').length, av: h.filter(r => g(r.hoy) === 'avanzo').length, ase: h.filter(r => r.acall > 0).length, hs: h.length}; }).sort((a, b) => b.n - a.n);
const top2 = PG.slice(0, 2);
$('h-prog').textContent = `${top2.map(x => x.p).join(' y ')} concentran ${pct(top2.reduce((s, x) => s + x.cv, 0), conv.length)} de las conversaciones.`;
const tot = PG.reduce((s, x) => ({n: s.n + x.n, per: s.per + x.per, cv: s.cv + x.cv, si: s.si + x.si, tv: s.tv + x.tv, av: s.av + x.av, ase: s.ase + x.ase, hs: s.hs + x.hs}), {n: 0, per: 0, cv: 0, si: 0, tv: 0, av: 0, ase: 0, hs: 0});
const prow = (x, cls) => `<tr class="${cls || ''}"><td class="who">${esc(x.p)}</td><td class="r">${fmt(x.n)}</td><td class="r">${x.per}</td><td class="r">${x.cv}</td><td class="r">${x.si}</td><td class="r">${x.tv}</td><td class="r">${x.av}</td><td class="r">${x.ase} <span class="t-mute">· ${pct(x.ase, x.hs)}</span></td></tr>`;
$('p-tabla').innerHTML = `<thead><tr><th>Programa</th><th class="r">Llamadas</th><th class="r">Personas</th><th class="r">Conversaron</th><th class="r">Sí</th><th class="r">Tal vez</th><th class="r">Avanzaron hoy</th><th class="r">Asesor llamó</th></tr></thead><tbody>` +
  PG.map(x => prow(x)).join('') + prow({...tot, p: 'Total'}, 'tot') + '</tbody>';
document.querySelector('#p-tabla tr.tot').querySelectorAll('td').forEach(td => { td.style.fontWeight = '700'; td.style.color = 'var(--fg)'; td.style.borderTop = '2px solid var(--rule)'; });

// riel: sección activa
const links = [...document.querySelectorAll('.app-sidebar-nav a')];
const secs = links.map(a => document.querySelector(a.getAttribute('href')));
function spy() {
  let cur = secs[0];
  for (const s of secs) if (s && s.getBoundingClientRect().top < 140) cur = s;
  links.forEach((a, i) => a.classList.toggle('active', secs[i] === cur));
  $('tb-section').textContent = cur ? cur.dataset.t : '';
}
addEventListener('scroll', spy, {passive: true}); spy();
</script>

</body></html>
