<style>
/* Sistema Adcom, suelo papel (un solo suelo por documento, a propósito): riel lateral oscuro + barra superior + contenido en fichas.
   Amarillo = marca (marcadores, activo, subrayado del titular), nunca relleno de dato. Datos en tinta y en las tres series. */
:root {
  --accent: #ffd400; --accent-ink: #3d3300; --accent-fg: #7d6800;
  --ground: #f4f4f1; --fg: #050505; --fg-secondary: #4a4a47; --fg-muted: #656560;
  --raised: #fcfcfa; --sunken: #e7e6e1; --rule: rgba(5,5,5,.13); --rule-strong: rgba(5,5,5,.88);
  --pos: #16693a; --neg: #c2261c;
  --serie-1: #2a78d6; --serie-2: #eb6834; --serie-3: #1baf7a; --serie-fg: #050505;
  --ramp-2: #c4c3bc; --ramp-3: #9a9992; --ramp-4: #4a4a47;
  --st-avanzo: #15803d; --st-seguimiento: #d97706; --st-interesado: #c4c3bc; --st-nocontesta: #6b6a64; --st-desiste: #b91c1c;
  --st-avanzo-soft: #e6f2ea; --st-seguimiento-soft: #fbefdc; --st-desiste-soft: #f8e4e2;
  --shell-bg: #0d0d0c; --shell-fg: #f4f4f1; --shell-fg-muted: #8a8a86; --shell-rule: rgba(244,244,241,.12); --shell-active: rgba(244,244,241,.08);
  --radius: 12px; --radius-sm: 8px;
  --fuente: Poppins, ui-sans-serif, -apple-system, "Segoe UI", sans-serif;
  --em-bg: linear-gradient(transparent 58%, var(--accent) 58%);
  --ease: cubic-bezier(.2,.7,.3,1);
  color-scheme: light;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--ground); color: var(--fg); font-family: var(--fuente); font-size: 14px; line-height: 1.5; }
body { display: flex; align-items: stretch; min-height: 100vh; }
h1, h2, h3, p { margin: 0; }

/* riel lateral */
.app-sidebar { width: 248px; flex: 0 0 auto; position: sticky; top: 0; align-self: flex-start; height: 100vh; overflow-y: auto; scrollbar-width: none;
  display: flex; flex-direction: column; background: var(--shell-bg); color: var(--shell-fg); }
.app-sidebar-top { padding: 22px 18px 18px; border-bottom: 1px solid var(--shell-rule); }
.app-sidebar-brand { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 16px; color: var(--shell-fg); font-weight: 800; font-size: .85rem; }
.app-sidebar-brand i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
.app-sidebar-client { padding: 10px 12px; background: rgba(244,244,241,.04); border: 1px solid var(--shell-rule); border-radius: var(--radius-sm); }
.app-sidebar-client span { display: block; font-size: .75rem; font-weight: 600; color: var(--shell-fg-muted); }
.app-sidebar-client strong { display: block; margin-top: 3px; font-size: .86rem; font-weight: 700; line-height: 1.3; }
.app-sidebar-nav { padding: 14px 10px; flex: 1; }
.app-sidebar-nav-title { display: block; padding: 6px 10px 8px; font-size: .75rem; font-weight: 700; color: var(--shell-fg-muted); }
.app-sidebar-nav a { display: flex; align-items: center; gap: 9px; padding: 8px 10px; margin-bottom: 1px; border-radius: var(--radius-sm); color: var(--shell-fg-muted);
  text-decoration: none; font-size: .8rem; font-weight: 600; line-height: 1.3; transition: background .15s var(--ease), color .15s var(--ease); }
.app-sidebar-nav a b { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .4; flex: 0 0 auto; }
.app-sidebar-nav a small { margin-left: auto; font-size: .75rem; font-weight: 600; font-variant-numeric: tabular-nums; }
.app-sidebar-nav a:hover { background: rgba(244,244,241,.06); color: var(--shell-fg); }
.app-sidebar-nav a.active { background: var(--shell-active); color: var(--shell-fg); }
.app-sidebar-nav a.active b { background: var(--accent); opacity: 1; }
.app-sidebar-nav a:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.app-sidebar-foot { padding: 14px 18px; border-top: 1px solid var(--shell-rule); color: var(--shell-fg-muted); font-size: .75rem; line-height: 1.5; }

/* principal */
.app-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.app-topbar { position: sticky; top: 0; z-index: 40; display: flex; align-items: center; gap: 10px; padding: 14px max(24px, env(safe-area-inset-right, 0px)) 14px 28px;
  background: rgba(244,244,241,.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--rule); }
.app-topbar-crumb { color: var(--fg-muted); font-size: .8rem; font-weight: 600; white-space: nowrap; }
.app-topbar-section { font-weight: 700; font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.app-topbar-section::before { content: "›"; margin-right: 10px; color: var(--fg-muted); font-weight: 400; }
.app-topbar-meta { margin-left: auto; color: var(--fg-muted); font-size: .78rem; font-weight: 600; white-space: nowrap; }
.content { padding: 28px max(24px, env(safe-area-inset-right, 0px)) 72px 28px; max-width: 1320px; width: 100%; }

/* portada */
.doc-head { display: grid; gap: 12px; padding-bottom: 28px; margin-bottom: 8px; border-bottom: 1px solid var(--rule-strong); }
.kicker { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-muted); }
.doc-head h1 { font-size: clamp(2rem, 4.6vw, 3.6rem); font-weight: 700; letter-spacing: -.035em; line-height: 1; text-wrap: balance; }
.doc-head h1 em { font-style: normal; background: linear-gradient(transparent 44%, var(--accent) 44%, var(--accent) 73%, transparent 73%); padding: 0 .06em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
.doc-head .lead { color: var(--fg-secondary); font-size: 1rem; max-width: 68ch; }

/* secciones */
section.sec { padding-top: 36px; display: grid; gap: 14px; scroll-margin-top: 64px; }
.sec-title { font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
.sec-title > i { display: inline-block; width: 3px; height: 13px; background: var(--accent); flex-shrink: 0; }
.sec-note { font-size: 12px; color: var(--fg-muted); font-weight: 400; margin-left: 4px; }
.headline { font-size: clamp(1.25rem, 2.2vw, 1.7rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.2; text-wrap: balance; max-width: 46ch; }
.card { background: var(--raised); border: 1px solid var(--rule); border-radius: var(--radius); min-width: 0; }
.pad { padding: 16px 18px; display: grid; gap: 12px; align-content: start; }
.cc-h { font-size: 13px; font-weight: 700; display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.kpi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
.kpi-grid.k4 { grid-template-columns: repeat(4, 1fr); }
.kpi-card { padding: 14px 16px; display: grid; gap: 2px; align-content: start; }
.kpi-label { font-size: 12px; color: var(--fg-secondary); font-weight: 600; }
.kpi-value { font-size: clamp(1.6rem, 2.6vw, 2.1rem); font-weight: 700; line-height: 1.15; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
.kpi-card.hi { box-shadow: inset 0 3px 0 var(--accent); }
.kpi-sub { font-size: 12px; color: var(--fg-muted); }
.note { font-size: 12.5px; color: var(--fg-muted); max-width: 90ch; }
.note b { color: var(--fg); font-weight: 600; }

/* barras horizontales: pista hundida, marca cuadrada */
.bl { display: grid; gap: 10px; }
.bl-row { display: grid; grid-template-columns: minmax(120px, 220px) 1fr 104px; gap: 12px; align-items: center; }
.bl-lbl { font-size: 12.5px; font-weight: 600; color: var(--fg-secondary); text-align: right; }
.bl-track { height: 12px; background: var(--sunken); min-width: 0; }
.bl-fill { height: 100%; background: var(--fg); min-width: 2px; border-radius: 0 4px 4px 0; }
.bl-val { font-size: 12.5px; font-variant-numeric: tabular-nums; white-space: nowrap; }
.bl-val b { font-size: 14px; }
.bl-val span { color: var(--fg-muted); }
.g-avanzo { background: var(--st-avanzo) !important; } .g-seguimiento { background: var(--st-seguimiento) !important; }
.g-interesado { background: var(--st-interesado) !important; } .g-nocontesta { background: var(--st-nocontesta) !important; } .g-desiste { background: var(--st-desiste) !important; }
.g-otro { background: var(--ramp-2) !important; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12px; color: var(--fg-secondary); }
.legend i { display: inline-block; width: 10px; height: 10px; margin-right: 6px; vertical-align: -1px; }

/* columnas por día */
.vb { display: flex; align-items: flex-end; gap: 10px; height: 210px; border-bottom: 1px solid var(--rule-strong); padding-top: 20px; }
.vb .col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 6px; height: 100%; min-width: 0; }
.vb .col b { font-size: 12.5px; font-variant-numeric: tabular-nums; }
.vb .col div { width: 64%; max-width: 56px; background: var(--fg); border-radius: 4px 4px 0 0; }
.vbl { display: flex; gap: 10px; }
.vbl span { flex: 1; text-align: center; font-size: 12px; color: var(--fg-muted); font-weight: 500; min-width: 0; }

/* antes / hoy */
.stk { display: grid; grid-template-columns: 52px 1fr; gap: 10px; align-items: center; }
.stk .lab { font-size: 12.5px; font-weight: 700; }
.stk .seg { display: flex; gap: 2px; height: 34px; }
.stk .seg div { display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: var(--serie-fg); min-width: 0; overflow: hidden; white-space: nowrap; }
.stk .seg div.g-desiste, .stk .seg div.g-avanzo, .stk .seg div.g-nocontesta { color: #fcfcfa; }

/* tablas */
.tbar { display: flex; align-items: flex-end; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--rule); flex-wrap: wrap; }
.fg { display: grid; gap: 3px; }
.fl { font-size: 12px; color: var(--fg-secondary); font-weight: 500; }
select, input[type=search] { font-family: var(--fuente); font-size: 12.5px; padding: 6px 9px; border: 1px solid var(--rule); border-radius: var(--radius-sm); background: var(--raised); color: var(--fg); outline: none; min-width: 150px; }
select:focus-visible, input:focus-visible { border-color: var(--accent-fg); box-shadow: 0 0 0 2px var(--accent); }
.btn-reset { font-family: var(--fuente); font-size: 12px; font-weight: 600; padding: 7px 12px; background: var(--fg); color: var(--ground); border: none; border-radius: var(--radius-sm); cursor: pointer; }
.btn-reset:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.t-count { margin-left: auto; font-size: 12px; color: var(--fg-muted); font-weight: 600; }
.tscroll { overflow-x: auto; }
.tscroll.tall { max-height: 620px; overflow: auto; }
table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
thead th { font-weight: 700; padding: 9px 10px; text-align: left; white-space: nowrap; color: var(--fg-muted); position: sticky; top: 0; background: var(--ground); border-bottom: 2px solid var(--rule); z-index: 1; }
thead th.s { cursor: pointer; user-select: none; } thead th.s:hover, thead th.on { color: var(--fg); }
tbody td { padding: 8px 10px; color: var(--fg-secondary); border-bottom: 1px solid var(--rule); vertical-align: middle; }
tbody td.who { color: var(--fg); font-weight: 600; min-width: 190px; }
#si-tabla, #c-tabla { min-width: 1080px; }
tbody td.who small { display: block; font-weight: 400; color: var(--fg-muted); font-size: 11.5px; }
tbody tr:hover td { background: rgba(5,5,5,.025); }
th.r, td.r { text-align: right; font-variant-numeric: tabular-nums; }
.pill.p-avanzo { background: var(--st-avanzo-soft); } .pill.p-seguimiento { background: var(--st-seguimiento-soft); } .pill.p-desiste { background: var(--st-desiste-soft); }
.pill { display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px 2px 7px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap; background: var(--sunken); color: var(--fg); }
.pill i { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
.from { color: var(--fg-muted); font-size: 11.5px; display: block; }
.t-neg { color: var(--neg); font-weight: 600; } .t-mute { color: var(--fg-muted); }
.foot-note { font-size: 12px; color: var(--fg-muted); padding: 10px 14px; border-top: 1px solid var(--rule); line-height: 1.5; }
.rules { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.rule-card { padding: 14px 16px; display: grid; gap: 4px; align-content: start; }
.rule-card .rk { font-size: 12px; color: var(--fg-secondary); font-weight: 600; }
.rule-card .rv { font-size: 1.15rem; font-weight: 700; letter-spacing: -.01em; line-height: 1.2; }
.rule-card .rt { font-size: 12.5px; color: var(--fg-muted); }
.tag { display: inline-block; padding: 1px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; }
.tag-si { background: var(--st-avanzo-soft); color: var(--st-avanzo); } .tag-no { background: var(--sunken); color: var(--fg-secondary); }
ul.cond { padding: 0; margin: 0; display: grid; gap: 8px; counter-reset: c; }
.cond li { list-style: none; display: grid; grid-template-columns: 26px 1fr; gap: 10px; align-items: start; font-size: 13.5px; color: var(--fg-secondary); }
.cond li::before { counter-increment: c; content: counter(c); width: 22px; height: 22px; border-radius: 50%; background: var(--fg); color: var(--ground); font-size: 12px; font-weight: 700; display: grid; place-items: center; }
.cond li b { color: var(--fg); }
footer.doc-foot { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--rule-strong); color: var(--fg-muted); font-size: 12.5px; display: grid; gap: 6px; max-width: 100ch; }

@media (max-width: 1200px) { .rules { grid-template-columns: repeat(2, 1fr); } .kpi-grid { grid-template-columns: repeat(3, 1fr); } .kpi-grid.k4 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 960px) { .two-col { grid-template-columns: 1fr; } }
@media (max-width: 900px) {
  body { flex-direction: column; }
  .app-sidebar { position: sticky; top: 0; z-index: 50; width: 100%; height: auto; flex-direction: row; align-items: center; overflow-x: auto; overflow-y: hidden; }
  .app-sidebar-top { padding: 10px max(14px, env(safe-area-inset-left, 0px)); border-bottom: 0; border-right: 1px solid var(--shell-rule); flex: 0 0 auto; display: flex; align-items: center; }
  .app-sidebar-brand { margin: 0; }
  .app-sidebar-client, .app-sidebar-nav-title, .app-sidebar-foot, .app-topbar { display: none; }
  .app-sidebar-nav { display: flex; align-items: center; gap: 2px; padding: 8px 10px; flex: 0 0 auto; }
  .app-sidebar-nav a { white-space: nowrap; }
  .content { padding: 20px max(16px, env(safe-area-inset-right, 0px)) 56px max(16px, env(safe-area-inset-left, 0px)); }
  section.sec { scroll-margin-top: 56px; }
}
@media (max-width: 560px) { .rules { grid-template-columns: 1fr; } .kpi-grid, .kpi-grid.k4 { grid-template-columns: repeat(2, 1fr); } .bl-row { grid-template-columns: 1fr 88px; } .bl-lbl { grid-column: 1 / -1; text-align: left; } }
@media (prefers-reduced-motion: no-preference) { .bl-fill, .vb .col div { transition: width .4s var(--ease), height .4s var(--ease); } }
</style>

